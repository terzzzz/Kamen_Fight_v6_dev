// js/agent_ichigo.js — Evolutionary Policy Engine for Kamen Rider Ichigo

(function (window) {
  'use strict';

  if (window.AgentIchigo) return;

  const STORAGE_KEY = 'ichigo_policy_v1';
  const DEFAULT_WEIGHTS_PATH = 'data/ichigo_weights.json';
  const ALL_OPPONENTS = ['nigo', 'v3', 'riderman', 'x', 'amazon'];

  // Expanded feature set (now includes rangePriority to counter Reach/Rope preempts)
  const FEATURE_NAMES = [
    'selfHp', 'oppHp',
    'selfChi', 'oppChi',
    'selfFaint', 'oppFaint',
    'hasRegenBuff',
    'moveAppliesDebuff',
    'expectedDmg',
    'chiCostPenalty',
    'rangePriority' // Crucial to prevent getting preempted by Range 2 moves
  ];

  function clamp01(v) { return Math.max(0, Math.min(1, v)); }

  function getRangePriority(move) {
    const range = String(move?.rangeType || 'MELEE').toUpperCase();
    if (range === 'PROJECTILE') return 3;
    if (['REACH', 'ROPE', 'MID_RANGE'].includes(range)) return 2;
    return 1;
  }

  function estimateExpectedDamage(move, self) {
    const base = move.baseDamage || 0;
    const hit = (move.hitChance || 80) / 100;
    const chargeFactor = ((self.activeChargePercent || 100) / 100);
    const buffAttack = (self.activeBuffs || []).some(b => 
      /focus|typhoon|red_lamp|power_focus|inca_blessing|gigi_focus/.test(String(b.id || ''))
    ) ? 1.15 : 1.0;
    return base * hit * chargeFactor * buffAttack;
  }

  function hasRegen(player) {
    return !!((player.activeBuffs || []).some(b => b.type === 'heal' || /regen|inca_blessing|lpRecovery/.test(String(b.id || ''))));
  }

  function moveAppliesDebuff(move) {
    return !!(move.debuff || (move.buff && move.buff.type === 'debuff'));
  }

  function extractFeatures(move, self, opp) {
    const selfHp = clamp01((self.lp || 0) / (self.maxLp || 3000));
    const oppHp = clamp01((opp.lp || 0) / (opp.maxLp || 3000));
    const selfChi = clamp01((self.chi || 0) / (self.maxChi || 16));
    const oppChi = clamp01((opp.chi || 0) / (opp.maxChi || 16));
    const faintLimit = (window.COMBAT_RULES && window.COMBAT_RULES.FAINT_THRESHOLD) || 100;
    const selfFaint = clamp01((self.faintMeter || 0) / faintLimit);
    const oppFaint = clamp01((opp.faintMeter || 0) / faintLimit);
    const regen = hasRegen(self) ? 1 : 0;
    const debuffWill = moveAppliesDebuff(move) ? 1 : 0;
    const expDmg = estimateExpectedDamage(move, self) / 1200;
    const chiCostPenalty = -((move.chiCost || 0) / 16);
    const rangePrio = (getRangePriority(move) - 1) / 2; // Normalized (0.0 for Melee, 0.5 for Reach, 1.0 for Projectile)

    return {
      selfHp, oppHp, selfChi, oppChi, selfFaint, oppFaint,
      hasRegenBuff: regen,
      moveAppliesDebuff: debuffWill,
      expectedDmg: expDmg,
      chiCostPenalty,
      rangePriority: rangePrio
    };
  }

  function scoreMoveWithWeights(move, cpu, opp, weights) {
    const f = extractFeatures(move, cpu, opp);
    let score = 0;
    FEATURE_NAMES.forEach(fn => {
      score += (weights[fn] || 0) * (f[fn] || 0);
    });
    score += 1e-5 * ( - (move.chiCost || 0) );
    return score;
  }

  function chooseBestMove(cpu, opp, moves, weights) {
    const validKeys = Object.keys(moves || {}).filter(k => (moves[k].chiCost || 0) <= (cpu.chi || 0));
    if (!validKeys.length) return 'DO_NOTHING';

    let best = validKeys[0], bestScore = -Infinity;
    validKeys.forEach(k => {
      const s = scoreMoveWithWeights(moves[k], cpu, opp, weights);
      if (s > bestScore) {
        bestScore = s;
        best = k;
      }
    });
    return best;
  }

  // --- Persistence & Repo Fallback ---
  let activePolicyStore = { ichigo: {} };

  async function loadStoredPolicies() {
    let fileWeights = {};
    try {
      const response = await fetch(DEFAULT_WEIGHTS_PATH);
      if (response.ok) fileWeights = await response.json();
    } catch (e) {
      /* Fallback to empty if file missing */
    }

    let localWeights = {};
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) localWeights = JSON.parse(raw);
    } catch (e) {
      console.warn('[AgentIchigo] Local storage parse error:', e);
    }

    activePolicyStore = {
      ichigo: Object.assign({}, fileWeights.ichigo || {}, localWeights.ichigo || {})
    };
    return activePolicyStore;
  }

  function persistPolicies(obj) {
    activePolicyStore = obj;
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(obj));
    } catch (e) {
      console.warn('[AgentIchigo] Persist error:', e);
    }
  }

  function getPolicyForOpponent(oppId) {
    return (activePolicyStore.ichigo && activePolicyStore.ichigo[oppId]) ? activePolicyStore.ichigo[oppId] : null;
  }

  // --- Evolutionary Training Core ---
  function randomWeights() {
    const w = {};
    FEATURE_NAMES.forEach(fn => {
      w[fn] = (Math.random() * 2 - 1) * 0.6;
    });
    w.expectedDmg = Math.abs(w.expectedDmg) + 0.6;
    w.rangePriority = Math.abs(w.rangePriority) + 0.4;
    return w;
  }

  function mutateWeights(base, sigma = 0.18) {
    const c = Object.assign({}, base);
    FEATURE_NAMES.forEach(fn => {
      c[fn] = c[fn] + randNormal() * sigma;
    });
    return c;
  }

  function randNormal() {
    let u = 0, v = 0;
    while (u === 0) u = Math.random();
    while (v === 0) v = Math.random();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
  }

  // Active override weight container for simulation evaluation
  window.__ichigo_eval_weights__ = null;

  async function evaluateCandidate(weights, opponentId, opts = {}) {
    const matches = opts.matches || 15;
    
    // Set global evaluation weight override
    window.__ichigo_eval_weights__ = weights;

    try {
      const data = await (window.KF && window.KF.loadData ? window.KF.loadData() : fetch('data/riders.json').then(r => r.json()));
      const ichigo = data.riders.find(r => r.id === 'ichigo');
      const opp = data.riders.find(r => r.id === opponentId);
      if (!ichigo || !opp) return { winRate: 0, avgLp: 0 };

      const res = await window.runBatchSimulation(
        { id: ichigo.id, name: ichigo.name },
        { id: opp.id, name: opp.name },
        matches,
        'adaptive',
        opts.opponentDifficulty || 'normal'
      );

      const winRate = Number(res.p1WinRate) || 0;
      const avgLp = Number(res.p1AvgLpLeft) || 0;
      return { winRate, avgLp };
    } catch (e) {
      console.warn('[AgentIchigo] Simulation eval error:', e);
      return { winRate: 0, avgLp: 0 };
    } finally {
      window.__ichigo_eval_weights__ = null;
    }
  }

  async function evolveStep(opponentId, options = {}) {
    const opts = Object.assign({ generations: 3, popSize: 6, elites: 2, matchesPerEval: 10, sigma: 0.18 }, options);
    let currentBest = getPolicyForOpponent(opponentId) || randomWeights();

    let population = [{ weights: currentBest, score: null }];
    while (population.length < opts.popSize) {
      population.push({ weights: mutateWeights(currentBest, opts.sigma), score: null });
    }

    for (let gen = 0; gen < opts.generations; gen++) {
      for (let i = 0; i < population.length; i++) {
        if (population[i].score === null) {
          const ev = await evaluateCandidate(population[i].weights, opponentId, { matches: opts.matchesPerEval });
          population[i].score = ev.winRate + (ev.avgLp / 1000);
          await new Promise(r => setTimeout(r, 16));
        }
      }

      population.sort((a, b) => b.score - a.score);
      const elites = population.slice(0, opts.elites);
      const newPop = elites.map(e => ({ weights: e.weights, score: e.score }));

      while (newPop.length < opts.popSize) {
        const parent = elites[Math.floor(Math.random() * elites.length)];
        newPop.push({ weights: mutateWeights(parent.weights, opts.sigma), score: null });
      }
      population = newPop;
    }

    const store = activePolicyStore;
    store.ichigo = store.ichigo || {};
    store.ichigo[opponentId] = population[0].weights;
    persistPolicies(store);
    console.log(`[AgentIchigo] Revised policy vs ${opponentId} (Score: ${population[0].score.toFixed(2)})`);
  }

  // --- Mobile Weight File Exporter ---
  function exportWeights(filename = 'ichigo_weights.json') {
    const jsonStr = JSON.stringify(activePolicyStore, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);

    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    console.log('[AgentIchigo] Exported trained weights successfully!');
  }

  // --- Background Auto-Trainer Loop ---
  let isTraining = false;
  async function autoTrainAllRiders() {
    if (isTraining || typeof window.runBatchSimulation !== 'function') return;
    isTraining = true;
    console.log('[AgentIchigo] Auto-training cycle started in background...');

    for (const oppId of ALL_OPPONENTS) {
      await evolveStep(oppId);
      await new Promise(r => setTimeout(r, 200));
    }

    isTraining = false;
    console.log('[AgentIchigo] Auto-training cycle completed.');
  }

  function recordMatchResult(opponentId, ichigoWon, keyMovesUsed = []) {
    let weights = getPolicyForOpponent(opponentId) || randomWeights();
    const lr = ichigoWon ? 0.05 : -0.03;

    keyMovesUsed.forEach(move => {
      if (move.baseDamage > 100) weights.expectedDmg += lr * 0.1;
      if (move.chiCost > 4) weights.chiCostPenalty -= lr * 0.05;
    });

    const store = activePolicyStore;
    store.ichigo = store.ichigo || {};
    store.ichigo[opponentId] = weights;
    persistPolicies(store);
  }

  // --- Init & Expose API ---
  loadStoredPolicies();

  window.AgentIchigo = {
    FEATURE_NAMES,
    extractFeatures,
    chooseBestMove,
    scoreMoveWithWeights,
    evaluateCandidate,
    evolveStep,
    autoTrainAllRiders,
    recordMatchResult,
    getPolicyForOpponent,
    loadStoredPolicies,
    persistPolicies,
    exportWeights,
    STORAGE_KEY
  };

  console.log('[AgentIchigo] Evolutionary Policy Agent Ready.');
})(window);
